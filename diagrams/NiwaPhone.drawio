  <diagram id="Q-yG_DsNlYyUZdbKgsIr" name="АППЗ-3.1">
    <mxGraphModel dx="3773" dy="1623" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam backgroundColor #FFFFFF\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam defaultFontSize 12\nskinparam classAttributeIconSize 0\nskinparam roundCorner 0\nskinparam shadowing false\n\nskinparam class {\n  BackgroundColor #FFFFFF\n  HeaderBackgroundColor #FFFFFF\n  BorderColor #000000\n  ArrowColor #000000\n  FontColor #000000\n}\n\nleft to right direction\n\npackage \&quot;Межові класи («boundary»)\&quot; {\n  class \&quot;СторінкаКаталогу\&quot; as CatalogPage &lt;&amp;lt;boundary&amp;gt;&gt; {\n    - searchQuery : String\n    - activeFilters : FilterParams\n    - productList : List&lt;Смартфон&gt;\n    --\n    + відобразитиКаталог() : void\n    + вибратиКарткуТовару(id : ObjectId) : void\n    + оновитиСписокТоварів() : void\n    + показатиСповіщення(msg : String) : void\n  }\n\n  class \&quot;ВікноКарткиТовару\&quot; as ProductViewModal &lt;&amp;lt;boundary&amp;gt;&gt; {\n    - selectedProductId : ObjectId\n    - displayedIMEI : String\n    - isModalOpen : Boolean\n    --\n    + відкритиКартку(product : Смартфон) : void\n    + натиснутиПозначитиПроданим() : void\n    + заблокуватиКнопкуПродажу() : void\n    + закритиКартку() : void\n  }\n\n  class \&quot;ДіалогПідтвердженняПродажу\&quot; as ConfirmDialog &lt;&amp;lt;boundary&amp;gt;&gt; {\n    - summaryText : String\n    - targetIMEI : String\n    - confirmState : Boolean\n    --\n    + показатиДіалог(model, imei, price) : void\n    + підтвердитиОперацію() : Boolean\n    + скасуватиОперацію() : void\n  }\n}\n\npackage \&quot;Керуючі класи («control»)\&quot; {\n  class \&quot;КонтролерПродажуТовару\&quot; as SaleController &lt;&amp;lt;control&amp;gt;&gt; {\n    - currentSellerId : ObjectId\n    - transactionTimestamp : Date\n    - operationStatus : String\n    --\n    + отриматиКарткуТовару(id : ObjectId) : Смартфон\n    + ініціюватиПродаж(id, imei, sellerId) : Result\n    + зафіксуватиЗмінуСтатусу(id : ObjectId) : Boolean\n    + зареєструватиТранзакцію() : ЗаписПродажу\n    + обробитиКонфліктПродажу() : String\n  }\n\n  class \&quot;КонтролерПеревіркиIMEI\&quot; as IMEIValidator &lt;&amp;lt;control&amp;gt;&gt; {\n    - imeiPattern : RegExp = /^[0-9]{15}$/\n    - validationContext : String\n    - validationError : String\n    --\n    + перевіритиФорматIMEI(imei : String) : Boolean\n    + обчислитиКонтрольнуЦифруЛуна(imei) : Boolean\n    + перевіритиДоступністьЗаIMEI(imei) : Boolean\n    + сформуватиВердикт(imei : String) : ValidationResult\n  }\n}\n\npackage \&quot;Сутнісні класи («entity»)\&quot; {\n  class \&quot;Співробітник\&quot; as Employee &lt;&amp;lt;entity&amp;gt;&gt; {\n    - id : ObjectId\n    - login : String\n    - fullName : String\n    - role : String\n    --\n    + перевіритиАктивнуСесію() : Boolean\n    + отриматиРольДоступу() : String\n    + отриматиІдентифікатор() : ObjectId\n  }\n\n  class \&quot;ЗаписПродажу\&quot; as SaleRecord &lt;&amp;lt;entity&amp;gt;&gt; {\n    - id : ObjectId\n    - productId : ObjectId\n    - sellerId : ObjectId\n    - imei : String\n    - salePrice : Number\n    - soldAt : Date\n    --\n    + створитиЗапис(data : SaleDTO) : ЗаписПродажу\n    + зберегтиТранзакцію() : Boolean\n  }\n\n  class \&quot;Смартфон\&quot; as Product &lt;&amp;lt;entity&amp;gt;&gt; {\n    - id : ObjectId\n    - brand : String\n    - model : String\n    - year : Number\n    - memory : String\n    - price : Number\n    - imei : String {unique, 15 digits}\n    - status : String\n    --\n    + знайтиЗаIMEI(imei : String) : Смартфон\n    + отриматиСтатус() : String\n    + встановитиСтатусПроданий(sellerId, date) : void\n    + отриматиХарактеристики() : ProductDTO\n  }\n}\n\nCatalogPage \&quot;1\&quot; --&gt; \&quot;0..1\&quot; ProductViewModal : відкриває картку\nProductViewModal \&quot;1\&quot; --&gt; \&quot;0..1\&quot; ConfirmDialog : викликає діалог\nSaleController \&quot;1\&quot; --&gt; \&quot;1\&quot; CatalogPage : оновлює стан\nProductViewModal \&quot;1\&quot; --&gt; \&quot;1\&quot; SaleController : запитує дані\nConfirmDialog \&quot;0..1\&quot; --&gt; \&quot;1\&quot; SaleController : підтверджує продаж\n\nSaleController \&quot;1\&quot; --&gt; \&quot;1\&quot; IMEIValidator : «include» (UC-08)\\nделегує перевірку IMEI\nSaleController \&quot;1\&quot; --&gt; \&quot;1\&quot; Employee : перевіряє сесію\nSaleController \&quot;1\&quot; --&gt; \&quot;0..1\&quot; SaleRecord : реєструє запис\nSaleController \&quot;1\&quot; --&gt; \&quot;1\&quot; Product : змінює статус\nIMEIValidator \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Product : верифікує IMEI\n\nEmployee \&quot;1\&quot; --&gt; \&quot;0..*\&quot; SaleRecord : оформлює\nProduct \&quot;1\&quot; --&gt; \&quot;0..1\&quot; SaleRecord : фіксується у\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="tSd7SuIiUJvj6QPPeI0u-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10 682 10 470;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
