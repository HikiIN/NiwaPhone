  <diagram id="A0gpkQ4yxcq3gtUl0JMF" name="МПЗ-2">
    <mxGraphModel dx="2005" dy="1818" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam defaultFontSize 11\nskinparam ArrowFontSize 10\nskinparam linetype ortho\nskinparam nodesep 70\nskinparam ranksep 110\nskinparam rectangle {\nBorderThickness 1.5\n}\nskinparam rectangle&lt;&lt;process&gt;&gt; {\nRoundCorner 25\nBorderThickness 2\n}\nskinparam database {\nBorderThickness 1.5\n}\n\nrectangle \&quot;Адміністратор\&quot; as Admin\nrectangle \&quot;Продавець\&quot; as Seller\nrectangle \&quot;Покупець\&quot; as Client\nrectangle \&quot;Менеджер з постачання\&quot; as SupMgr\nrectangle \&quot;Google OAuth\&quot; as OAuth\n\nrectangle \&quot;1.0\\nАвтентифікація\\nта сесії\&quot; as P1 &lt;&lt;process&gt;&gt;\nrectangle \&quot;2.0\\nКерування\\nкористувачами\&quot; as P2 &lt;&lt;process&gt;&gt;\nrectangle \&quot;3.0\\nВедення каталогу\\nта облік смартфонів\&quot; as P3 &lt;&lt;process&gt;&gt;\nrectangle \&quot;4.0\\nОпрацювання замовлень\\nта продаж\&quot; as P4 &lt;&lt;process&gt;&gt;\nrectangle \&quot;5.0\\nКерування\\nпостачальниками\&quot; as P5 &lt;&lt;process&gt;&gt;\nrectangle \&quot;6.0\\nФормування\\nаналітичних звітів\&quot; as P6 &lt;&lt;process&gt;&gt;\nrectangle \&quot;7.0\\nРезервне копіювання\\nта експорт/імпорт\&quot; as P7 &lt;&lt;process&gt;&gt;\n\ndatabase \&quot;D1: Користувачі\&quot; as D1\ndatabase \&quot;D2: Товари (Смартфони)\&quot; as D2\ndatabase \&quot;D3: Продажі (Чеки)\&quot; as D3\ndatabase \&quot;D4: Постачальники\&quot; as D4\ndatabase \&quot;D5: Резервні копії\&quot; as D5\n\n&#39; --- 1.0 Автентифікація ---\nAdmin --&gt; P1 : Запит входу\nP1 --&gt; OAuth : Запит токена\nOAuth --&gt; P1 : Токен\nP1 --&gt; D1 : Перевірка ролі\nP1 --&gt; Admin : Сесія\n\n&#39; --- 2.0 Користувачі ---\nAdmin --&gt; P2 : Дані корист.\nP2 --&gt; D1 : Запис\nD1 --&gt; P2 : Дані корист.\nP2 --&gt; Admin : Список\n\n&#39; --- 3.0 Каталог ---\nAdmin --&gt; P3 : Додавання\nClient --&gt; P3 : Пошук\nSeller --&gt; P3 : Перевірка IMEI\nP3 --&gt; D2 : Збереження\nD2 --&gt; P3 : Інфо про товари\nP3 --&gt; Client : Результати\nP3 --&gt; Seller : Інфо про товар\n\n&#39; --- 4.0 Замовлення ---\nClient --&gt; P4 : Замовлення\nSeller --&gt; P4 : Оформлення\nP4 --&gt; D2 : Статус «проданий»\nP4 --&gt; D3 : Запис продажу\nP4 --&gt; Seller : Підтвердження\n\n&#39; --- 5.0 Постачальники ---\nSupMgr --&gt; P5 : Дані постач.\nP5 --&gt; D4 : Збереження\nD4 --&gt; P5 : Відомості\nP5 --&gt; SupMgr : Список\n\n&#39; --- 6.0 Звіти ---\nAdmin --&gt; P6 : Запит звіту\nD2 --&gt; P6 : Залишки\nD3 --&gt; P6 : Виручка\nP6 --&gt; Admin : Дашборд\n\n&#39; --- 7.0 Бекап ---\nAdmin --&gt; P7 : Експорт / імпорт\nD1 --&gt; P7 : Експорт D1\nD2 --&gt; P7 : Експорт D2\nD3 --&gt; P7 : Експорт D3\nD4 --&gt; P7 : Експорт D4\nP7 --&gt; D5 : Бекап\nP7 --&gt; Admin : JSON / статус\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4GwSpu27koy7nXJlbT5l-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="4GwSpu27koy7nXJlbT5l-169" edge="1" parent="4GwSpu27koy7nXJlbT5l-1" source="4GwSpu27koy7nXJlbT5l-115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="4GwSpu27koy7nXJlbT5l-122">
